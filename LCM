import java.util.*;

public class Main {
    public static void main(String args[]) {
        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();
        long lcm = sc.nextLong();

        for (int i = 1; i < n; i++) {
            long num = sc.nextLong();

            long a = num;
            long b = lcm;

            while (b != 0) {
                long temp = b;
                b = a % b;
                a = temp;
            }

            lcm = (lcm / a) * num;   
        }

        System.out.println(lcm);
    }
}
