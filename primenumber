import java.util.*;
public class Main{
    public static void main(String args[]){
        int n =8;
          if(n<2){
              System.out.print("not a Prime");
          }
        for(int i=2;i<n;i++){
                if(n%i==0){
                System.out.print(n+" "+"Not a Prime");
                return;
                }
            }
        System.out.print(n+" "+"prime");
    }
}
