#include<iostream>
#include<string>
using namespace std;
int main(){
    string s1;
    cin>>s1;
    string s2;
    cin>>s2;
    if(s1.length()!=s2.length()){
        cout<<"false";
        return 0;
    }
    int count[26]={0};
    for(int i=0;i<s1.length();i++){
        count[s1[i]-'a']++;
        count[s2[i]-'a']--;
    }
    for(int i=0;i<26;i++){
        if(count[i]!=0){
            cout<<"false";
            return 0;
        }
    }
    cout<<"true";
    return 0;
}
