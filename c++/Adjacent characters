#include <iostream>
#include<string>
using namespace std;
int main() {
   string str;
    cin>>str;
    string res;
    for(int i=0;i<str.length()-1;i++){
        if(str[i]==str[i+1]){
            res+=str[i];
            res+="*";
        }
        else{
            res+=str[i];
        }
    }
    res+=str[str.length()-1];
    cout<<res;

    return 0;
}

Input 1 :
hello
Output 1 :
hel*lo
