#include<iostream>
using namespace std;
int main(){
    int n;
    cin>>n;
    int arr[n];
    for(int i=0;i<n;i++){
        cin>>arr[i];
    }
    int res=0;
    for(int i=0;i<n;i++){
        int count=0;
        for(int j=0;j<n;j++){
            if(arr[i]==arr[j]){
                count++;
            }
        }
        if(count==1){
            res+=arr[i];
        }
    }
    if(res==0){
        cout<<arr[0];
   }
   else{
        cout<<res;
    }
    return 0;
    
}

Sample test cases :
Input 1 :
3
1 2 1
Output 1 :
2
Input 2 :
3
1 1 1
Output 2 :
1
