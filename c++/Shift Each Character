#include <iostream>
#include<string>
using namespace std;
int main() {
    string s="CoDe";
    string res="";
    for(int i=0;i<s.length();i++){
        if(s[i]>='a'&&s[i]<='z'){
            s[i]=s[i]+1;
                 if(s[i]>'z'){
                     s[i]=s[i]-26;
                 }
        }
         if(s[i]>='A'&&s[i]<='Z'){
            s[i]=s[i]+1;
                 if(s[i]>'Z'){
                     s[i]=s[i]-26;
                 }
        }
        res=res+s[i];
    }
    cout<<res;
    return 0;
}
