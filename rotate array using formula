import java.util.*;
class Main {
    public static void main(String[] args) {
        int arr[]={1,2,3,4,5};
        int n=arr.length;
        int k=3;
        int temp[]=new int[n];
            for(int i=0;i<arr.length;i++){
                temp[(i+k)%n]=arr[i];
            }
    for(int a:temp){
        System.out.print(a+" ");
    }
}
}
