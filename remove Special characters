import java.util.*;
class Main {
    public static void main(String[] args) {
          String str="he@llo#123";
          StringBuilder sb = new StringBuilder();
          for(int i=0;i<str.length();i++){
              char ch =str.charAt(i);
              if(Character.isLetterOrDigit(ch)){
                  sb.append(ch);
              }
          }
          System.out.print(sb);
        }
    }
