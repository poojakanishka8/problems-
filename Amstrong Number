class Main {
    public static void main(String[] args) {
        int n=153;
        int org=n;
        int rev=0;
        while(n!=0){
            int d =n%10;
            rev=rev+d*d*d;
            n=n/10;
    }
    if(org==rev){
        System.out.print(org+" "+"Is Amstrong Number");
    }
    else{
        System.out.print(org+" "+"Is Not A Amstrong Number");
    }
}
}
